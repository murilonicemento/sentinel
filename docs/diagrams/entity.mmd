classDiagram
%% =====================
%% Namespace: Ingestion
%% =====================
%% Domain / Persistence Namespace
namespace Ingestion.Domain {
  class DataSource {
    +Id: Guid
    +Name: string
    +Type: DataSourceTypeEnum
    +Endpoint: string
    +CollectionFrequency: CollectionFrequencyEnum
  }

  class DataCollection {
    +Id: Guid
    +DataSourceIdÇ Guid
    +CollectedAt: DateTime
    +Payload: string
  }

  class SensorSample {
    +Id: Guid
    +DataCollectionId: Guid
    +SensorValue: double
    +Unit: string
    +RecordedAt: DateTime
  }
}

%% Relações de aggregate
DataSource "1" --> "N" DataCollection
DataCollection "1" --> "N" SensorSample

%% Enums
namespace Ingestion.Domain.Enums {
  class DataSourceType {
    <<enumeration>>
    Sensor
    Api
    File
    ExternalSystem
  }

  class CollectionFrequency {
    <<enumeration>>
    Hourly
    Daily
    Weekly
  }
}

%% Namespace de eventos (publicados para downstream)
namespace Ingestion.Events {
    class ClimaticEventDTO {
      +EventId: Guid
      +EventType: string
      +Latitude: double
      +Longitude: double
      +Intensity: double
      +CollectedAt: DateTime
    }
}

%% =====================
%% Namespace: Risk Catalog
%% =====================
namespace RiskCatalog.Domain {

  %% ===== Event Types and Severity =====
  class EventType {
    +Id: Guid
    +Code: string
    +Name: string
    +Description: string
    +IsActive: bool
  }

  class Severity {
    +Id: Guid
    +Level: SeverityLevelEnum
    +Description: string
  }

  class SeverityCriterion {
    +Id: Guid
    +EventTypeId: Guid
    +SeverityId: Guid
    +MinValue: double
    +MaxValue: double
    +Unit: string
    +Version: int
  }

  %% ===== Risk Matrices and IDF Curves =====
  class RiskMatrix {
    +Id: Guid
    +EventTypeId: Guid
    +SeverityLevel: SeverityLevelEnum
    +RiskLevel: RiskLevelEnum
    +Version: int
  }

  class IDFCurve {
    +Id: Guid
    +EventTypeId: Guid
    +DurationMinutes: int
    +Intensity: double
    +ReturnPeriodYears: int
    +Version: int
  }

  class RegionalParameter {
    +Id: Guid
    +RegionId: Guid
    +AdjustmentFactor: double
    +Description: string
  }
}

%% ---------------------
%% Domain Relationships
%% ---------------------
EventType "1" --> "N" SeverityCriterion
Severity "1" --> "N" SeverityCriterion

EventType "1" --> "N" RiskMatrix
EventType "1" --> "N" IDFCurve

RiskMatrix --> EventType
IDFCurve --> EventType
RegionalParameter --> RiskMatrix

%% ---------------------
%% Enums
%% ---------------------
namespace RiskCatalog.Domain.Enums {

  class SeverityLevel {
    <<enumeration>>
    Low
    Moderate
    High
    Extreme
  }

  class RiskLevel {
    <<enumeration>>
    Low
    Medium
    High
    Critical
  }
}

%% =====================
%% Application DTOs (Read / Sync)
%% =====================
namespace RiskCatalog.Application.DTOs {

  class EventTypeDTO {
    +Id: Guid
    +Code: string
    +Name: string
  }

  class SeverityCriterionDTO {
    +EventTypeCode: string
    +SeverityLevel: string
    +MinValue: double
    +MaxValue: double
    +Unit: string
    +Version: int
  }

  class RiskMatrixDTO {
    +EventTypeCode: string
    +SeverityLevel: string
    +RiskLevel: string
    +Version: int
  }
}

%% ---------------------
%% Dependencies (read-only)
%% ---------------------
EventType --> EventTypeDTO
SeverityRule --> SeverityRuleDTO
RiskMatrix --> RiskMatrixDTO


