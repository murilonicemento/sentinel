flowchart TD
%% Arquitetura do Sentinel no estado atual (verificado no código e em platform/docker-compose.yml em 2026-11-04).
%% Setas sólidas: HTTP síncrono. Setas tracejadas: tópicos Kafka (ADR-0008 a ADR-0012).
%% Tópicos depreciados (sensor-event-detected, region-intersected, risk-events) e dead-letters por serviço não aparecem.
    subgraph External[Fontes e provedores externos]
        Sensors[Sensores e clientes HTTP]
        USGS[USGS Earthquake]
        FIRMS[NASA FIRMS]
        NOAA[NOAA NCEI CDO]
        Stormglass[Stormglass]
        Twilio[Twilio SMS e WhatsApp]
        SendGrid[SendGrid e-mail]
        PushSiren[Push HTTP, sirene HTTP, broker MQTT]
    end

    Gateway[api-gateway<br/>Ocelot, rate limit por IP]

    subgraph Pipeline[Pipeline de risco e alerta]
        Ingestion[ingestion<br/>PostgreSQL + outbox, MongoDB leitura,<br/>MinIO payload bruto, Redis dedup]
        Geospatial[geospatial<br/>NetTopologySuite, Elasticsearch]
        RiskCatalog[risk-catalog<br/>PostgreSQL, Redis cache]
        RiskEvaluation[risk-evaluation<br/>MongoDB, Redis]
        AlertOrchestrator[alert-orchestrator<br/>PostgreSQL, Redis]
        Channels[channels<br/>PostgreSQL, Redis]
    end

    subgraph Governance[Tenancy, relatórios e auditoria]
        TenantsBilling[tenants-billing<br/>PostgreSQL]
        Reporting[reporting<br/>PostgreSQL, Elasticsearch, Redis]
        AuditCompliance[audit-compliance<br/>MongoDB + GridFS]
    end

    subgraph Observability[Observabilidade ADR-0004]
        Loki[Loki]
        Tempo[Tempo]
        Prometheus[Prometheus]
        Grafana[Grafana<br/>dashboards e alertas]
    end

    %% Entrada
    Sensors --> Gateway
    Gateway --> Ingestion
    Gateway --> RiskCatalog
    Gateway --> Geospatial
    Gateway --> RiskEvaluation
    Gateway --> AlertOrchestrator
    Gateway --> Channels
    Gateway --> Reporting
    Gateway --> TenantsBilling
    Gateway --> AuditCompliance
    USGS --> Ingestion
    FIRMS --> Ingestion
    NOAA --> Ingestion
    Stormglass --> Ingestion

    %% HTTP entre serviços (token de serviço, ADR-0002)
    Ingestion -->|operações v1| Geospatial
    RiskCatalog -->|operações v1| Geospatial
    RiskEvaluation -->|listagens v1 do catálogo publicado| RiskCatalog
    Ingestion -->|tenant ativo?| TenantsBilling
    AlertOrchestrator -->|tenant ativo?| TenantsBilling
    Channels -->|tenant ativo?| TenantsBilling

    %% Eventos
    Ingestion -.->|disaster-event-detected<br/>climatic-event-detected| RiskEvaluation
    Ingestion -.->|disaster-event-detected<br/>climatic-event-detected| Geospatial
    RiskCatalog -.->|risk-catalog-published| RiskEvaluation
    RiskEvaluation -.->|risk-updated| AlertOrchestrator
    AlertOrchestrator -.->|alert-commands| Channels
    Ingestion -.->|tenant-usage-events| TenantsBilling
    AlertOrchestrator -.->|tenant-usage-events| TenantsBilling
    Channels -.->|tenant-usage-events| TenantsBilling
    AlertOrchestrator -.->|reporting-events| Reporting
    Channels -.->|reporting-events| Reporting
    TenantsBilling -.->|audit-events| AuditCompliance

    %% Entrega
    Channels --> Twilio
    Channels --> SendGrid
    Channels --> PushSiren

    %% Telemetria: logs (Serilog), traces (OTLP) e métricas (/metrics) de cada serviço
    Pipeline -.->|logs| Loki
    Governance -.->|logs| Loki
    Pipeline -.->|traces OTLP| Tempo
    Governance -.->|traces OTLP| Tempo
    Prometheus -->|scrape /metrics| Pipeline
    Prometheus -->|scrape /metrics| Governance
    Grafana --> Loki
    Grafana --> Tempo
    Grafana --> Prometheus
