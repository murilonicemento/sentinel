{
  "uid": "sentinel-messaging",
  "title": "Sentinel - Mensageria (Kafka)",
  "tags": [
    "sentinel",
    "kafka"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Serviço",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "multi": true,
        "includeAll": true,
        "refresh": 2,
        "query": "label_values(up{job=\"sentinel-services\"}, service)",
        "definition": "label_values(up{job=\"sentinel-services\"}, service)"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Mensagens consumidas por resultado",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, outcome) (rate(sentinel_messages_handled_total{service=~\"$service\"}[5m]))",
          "legendFormat": "{{service}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "description": "processed = tratada; dead_lettered = enviada ao DLQ; not_durable = consumidor voltou ao offset e pausou (ADR-0003)."
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Enviadas ao DLQ (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, topic) (increase(sentinel_messages_handled_total{service=~\"$service\",outcome=\"dead_lettered\"}[1h]))",
          "legendFormat": "{{service}} {{topic}}"
        },
        {
          "refId": "B",
          "expr": "sum(increase(audit_events_dead_lettered_total[1h]))",
          "legendFormat": "audit-compliance"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Consumo pausado (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, topic) (increase(sentinel_messages_handled_total{service=~\"$service\",outcome=\"not_durable\"}[1h]))",
          "legendFormat": "{{service}} {{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Retentativas",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, topic) (rate(sentinel_message_retries_total{service=~\"$service\"}[5m]))",
          "legendFormat": "{{service}} {{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "audit-compliance: falhas de processamento",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(audit_processing_failures_total[5m]))",
          "legendFormat": "falhas"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
