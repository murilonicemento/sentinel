ConnectionStrings__RiskCatalogDatabase=Host=postgres;Port=5432;Database=ingestion;Username=postgres;Password=Y0uRStr0ngP@SSWorD;

# =========================
# PostgreSQL
# =========================
POSTGRES_DB=ingestion
POSTGRES_USER=sentinel_user
POSTGRES_PASSWORD=TrocaEssaSenha123

# =========================
# MongoDB
# =========================
MONGO_INITDB_ROOT_USERNAME=sentinel_user
MONGO_INITDB_ROOT_PASSWORD=TrocaEssaSenha123

# =========================
# MinIO
# =========================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# =========================
# Audit & Compliance Service
# =========================
# Senha do usuário de privilégio mínimo criado em platform/init-db/mongodb (somente em volume novo)
AUDIT_COMPLIANCE_DB_PASSWORD=TrocaEssaSenha123
# Chave HS256 (mínimo 32 caracteres) compartilhada com o emissor dos tokens.
# Opcional: sem ela, o serviço usa JWT_SIGNING_KEY, a chave de usuário da plataforma.
AUDIT_COMPLIANCE_JWT_SIGNING_KEY=troque-por-uma-chave-com-pelo-menos-32-caracteres

# =========================
# Autenticação entre serviços (ADR-0002)
# =========================
# Use valores aleatórios com pelo menos 32 caracteres, por exemplo: openssl rand -base64 48
# Emissor, audiência e chave HS256 dos tokens de usuário, aceitos por todos os serviços
JWT_ISSUER=sentinel
JWT_AUDIENCE=sentinel
JWT_SIGNING_KEY=troque-por-uma-chave-com-pelo-menos-32-caracteres
# Chave exclusiva de cada serviço que chama outro; nunca reutilize a mesma chave entre serviços
INGESTION_SERVICE_TOKEN_SIGNING_KEY=troque-pela-chave-do-ingestion-com-32-caracteres
RISK_CATALOG_SERVICE_TOKEN_SIGNING_KEY=troque-pela-chave-do-risk-catalog-com-32-caracteres
RISK_EVALUATION_SERVICE_TOKEN_SIGNING_KEY=troque-pela-chave-do-risk-evaluation-com-32-caracteres
ALERT_ORCHESTRATOR_SERVICE_TOKEN_SIGNING_KEY=troque-pela-chave-do-alert-orchestrator-com-32-caracteres
CHANNELS_SERVICE_TOKEN_SIGNING_KEY=troque-pela-chave-do-channels-com-32-caracteres

# =========================
# Channels Service (provedores opcionais em ambiente local)
# =========================
# Sem credenciais, as entregas falham e vão para notification-events-dlq.
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PUSH_API_KEY=
SIREN_API_KEY=
