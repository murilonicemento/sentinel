{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Grafana.Loki"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://localhost:3100",
          "labels": [
            {
              "key": "service",
              "value": "audit-compliance"
            }
          ],
          "propertiesAsLabels": [
            "level"
          ]
        }
      }
    ]
  },
  "Jwt": {
    "Issuer": "sentinel",
    "Audience": "sentinel",
    "SigningKey": ""
  },
  "MongoDb": {
    "ConnectionString": "",
    "DatabaseName": "AuditComplianceDatabase",
    "EnsureIndexesOnStartup": false
  },
  "Kafka": {
    "ConsumerEnabled": true,
    "BootstrapServers": "localhost:9093",
    "ConsumerGroupId": "audit-compliance-group",
    "AuditEventsTopic": "audit-events",
    "ReplayTopic": "audit-events-replay",
    "DeadLetterTopic": "audit-events-dlq",
    "MaxProcessingAttempts": 3,
    "InitialRetryDelayMilliseconds": 500,
    "StorageUnavailablePauseSeconds": 30
  },
  "AuditQuery": {
    "MaxQueryRangeDays": 90,
    "MaxExportRangeDays": 366
  },
  "Exports": {
    "WorkerEnabled": true,
    "MaxRecords": 10000,
    "FileExpirationHours": 24,
    "ProcessingLeaseMinutes": 10,
    "MaxProcessingAttempts": 3,
    "PollIntervalSeconds": 10
  },
  "RateLimiting": {
    "QueriesPerMinute": 120,
    "ExportsPerMinute": 10
  }
}
