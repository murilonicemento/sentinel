{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Jwt": {
    "Issuer": "sentinel",
    "Audience": "sentinel",
    "SigningKey": ""
  },
  "MongoDb": {
    "ConnectionString": "",
    "DatabaseName": "AuditComplianceDatabase",
    "EnsureIndexesOnStartup": false
  },
  "Kafka": {
    "ConsumerEnabled": true,
    "BootstrapServers": "localhost:9093",
    "ConsumerGroupId": "audit-compliance-group",
    "AuditEventsTopic": "audit-events",
    "ReplayTopic": "audit-events-replay",
    "DeadLetterTopic": "audit-events-dlq",
    "MaxProcessingAttempts": 3,
    "InitialRetryDelayMilliseconds": 500,
    "StorageUnavailablePauseSeconds": 30
  },
  "AuditQuery": {
    "MaxQueryRangeDays": 90,
    "MaxExportRangeDays": 366
  },
  "Exports": {
    "WorkerEnabled": true,
    "MaxRecords": 10000,
    "FileExpirationHours": 24,
    "ProcessingLeaseMinutes": 10,
    "MaxProcessingAttempts": 3,
    "PollIntervalSeconds": 10
  },
  "RateLimiting": {
    "QueriesPerMinute": 120,
    "ExportsPerMinute": 10
  }
}
