{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "RiskCatalogDatabase": "Host=postgres;Port=5432;Database=risk_catalog;Username=postgres",
    "Redis": "redis:6379",
    "Kafka": "kafka:9092"
  },
  "Geospatial": {
    "BaseUrl": "http://geospatial:8080"
  },
  "Jwt": {
    "Issuer": "sentinel",
    "Audience": "sentinel",
    "SigningKey": ""
  },
  "ServiceToken": {
    "Issuer": "sentinel-service:risk-catalog",
    "Audience": "sentinel",
    "SigningKey": "",
    "Roles": [
      "Geospatial.Read"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
