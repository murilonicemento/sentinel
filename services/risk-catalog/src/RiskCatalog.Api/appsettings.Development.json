{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "RiskCatalogDatabase": "Host=postgres;Port=5432;Database=risk_catalog;Username=postgres;Password=postgres",
    "Redis": "redis:6379",
    "Kafka": "kafka:9092"
  },
  "ElasticSearch": {
    "URI": "http://elasticsearch:9200"
  },
  "Geospatial": {
    "BaseUrl": "http://geospatial:8080"
  },
  "Jwt": {
    "Issuer": "sentinel",
    "Audience": "sentinel",
    "Key": "super-secret-key-change-this"
  },
  "Scalar": {
    "AuthToken": "changeme"
  }
}
