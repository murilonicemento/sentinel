{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IngestionReadDatabase": "mongodb://mongo:27017/?authSource=admin",
    "IngestionWriteDatabase": "Host=postgres;Port=5432;Database=ingestion;Username=user",
    "Kafka": "kafka:9093",
    "Redis": "redis:6379"
  },
  "MinIO": {
    "BucketName": "sentinel-ingestion-service",
    "Host": "minio",
    "Port": "9000",
    "AccessKey": "",
    "SecretKey": ""
  },
  "Geospatial": {
    "BaseUrl": "http://geospatial:8080"
  },
  "Jwt": {
    "Issuer": "sentinel",
    "Audience": "sentinel",
    "SigningKey": ""
  },
  "Polling": {
    "Fire": {
      "Enabled": false,
      "BaseUrl": "https://firms.modaps.eosdis.nasa.gov",
      "IntervalMinutes": 180,
      "LookbackHours": 24,
      "Subscriptions": []
    },
    "Earthquake": {
      "Enabled": false,
      "BaseUrl": "https://earthquake.usgs.gov",
      "IntervalMinutes": 15,
      "LookbackHours": 24,
      "Subscriptions": []
    },
    "Flood": {
      "Enabled": false,
      "BaseUrl": "https://www.ncei.noaa.gov/cdo-web/api/v2",
      "IntervalMinutes": 1440,
      "LookbackHours": 72,
      "Subscriptions": []
    },
    "Landslide": {
      "Enabled": false,
      "BaseUrl": "https://www.ncei.noaa.gov/cdo-web/api/v2",
      "IntervalMinutes": 1440,
      "LookbackHours": 72,
      "Subscriptions": []
    },
    "TemperatureAnomaly": {
      "Enabled": false,
      "BaseUrl": "https://www.ncei.noaa.gov/cdo-web/api/v2",
      "IntervalMinutes": 1440,
      "LookbackHours": 72,
      "Subscriptions": []
    },
    "HumidityAnomaly": {
      "Enabled": false,
      "BaseUrl": "https://www.ncei.noaa.gov/cdo-web/api/v2",
      "IntervalMinutes": 1440,
      "LookbackHours": 72,
      "Subscriptions": []
    },
    "WindGust": {
      "Enabled": false,
      "BaseUrl": "https://api.stormglass.io/v2",
      "IntervalMinutes": 180,
      "LookbackHours": 6,
      "Subscriptions": []
    },
    "Rainfall": {
      "Enabled": false,
      "BaseUrl": "https://api.stormglass.io/v2",
      "IntervalMinutes": 180,
      "LookbackHours": 6,
      "Subscriptions": []
    },
    "PressureChange": {
      "Enabled": false,
      "BaseUrl": "https://api.stormglass.io/v2",
      "IntervalMinutes": 180,
      "LookbackHours": 6,
      "Subscriptions": []
    }
  },
  "ServiceToken": {
    "Issuer": "sentinel-service:ingestion",
    "Audience": "sentinel",
    "SigningKey": "",
    "Roles": [
      "TenantsBilling.Read",
      "Geospatial.Read"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "TenantsBilling": {
    "BaseUrl": "http://localhost:5055"
  }
}
