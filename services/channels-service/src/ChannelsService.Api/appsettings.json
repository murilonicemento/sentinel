{
  "Kafka": {
    "BootstrapServers": "localhost:9093",
    "ConsumerGroupId": "channels-service-group",
    "Topic": "notification-events",
    "DeadLetterTopic": "notification-events-dlq"
  },
  "ConnectionStrings": {
    "ChannelsServiceDatabase": "Host=localhost;Port=5432;Database=channels_service;Username=postgres;Password=postgres"
  },
  "Redis": {
    "Configuration": "localhost:6379",
    "TenantSettingsCacheTtlSeconds": 300
  },
  "ChannelsService": {
    "DefaultTenantSettings": {
      "TenantId": "default",
      "EnabledChannels": ["Sms", "Email", "Push", "Mqtt"],
      "PriorityOrder": {
        "Sms": 1,
        "Email": 2,
        "Push": 3,
        "Mqtt": 4,
        "WhatsApp": 5,
        "Siren": 6
      },
      "MaxRetries": {
        "Sms": 3,
        "Email": 2,
        "Push": 2,
        "Mqtt": 2,
        "WhatsApp": 2,
        "Siren": 3
      },
      "FallbackOrder": ["Sms", "Push", "Email"]
    },
    "Providers": {
      "Email": {
        "Type": "SendGrid",
        "Options": {
          "ApiKey": "${SENDGRID_API_KEY}",
          "FromEmail": "no-reply@example.com",
          "FromName": "Sentinel Notifications"
        },
        "Resilience": {
          "TimeoutSeconds": 15,
          "CircuitBreakerFailureThreshold": 3,
          "CircuitBreakerDurationSeconds": 30,
          "CircuitBreakerSamplingDurationSeconds": 60
        }
      },
      "Sms": {
        "Type": "Twilio",
        "Options": {
          "AccountSid": "${TWILIO_ACCOUNT_SID}",
          "AuthToken": "${TWILIO_AUTH_TOKEN}",
          "FromNumber": "+1234567890"
        },
        "Resilience": {
          "TimeoutSeconds": 15,
          "CircuitBreakerFailureThreshold": 3,
          "CircuitBreakerDurationSeconds": 30,
          "CircuitBreakerSamplingDurationSeconds": 60
        }
      },
      "WhatsApp": {
        "Type": "TwilioWhatsApp",
        "Options": {
          "AccountSid": "${TWILIO_ACCOUNT_SID}",
          "AuthToken": "${TWILIO_AUTH_TOKEN}",
          "FromNumber": "+1234567890"
        },
        "Resilience": {
          "TimeoutSeconds": 15,
          "CircuitBreakerFailureThreshold": 3,
          "CircuitBreakerDurationSeconds": 30,
          "CircuitBreakerSamplingDurationSeconds": 60
        }
      },
      "MQTT": {
        "Type": "Mqtt",
        "Options": {
          "Broker": "localhost",
          "Port": 1883,
          "Topic": "notifications/mqtt",
          "ClientId": "channels-service-mqtt"
        },
        "Resilience": {
          "TimeoutSeconds": 15,
          "CircuitBreakerFailureThreshold": 3,
          "CircuitBreakerDurationSeconds": 30,
          "CircuitBreakerSamplingDurationSeconds": 60
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  }
}
