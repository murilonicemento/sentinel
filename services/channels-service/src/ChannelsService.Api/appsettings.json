{
  "Kafka": {
    "BootstrapServers": "localhost:9093",
    "ConsumerGroupId": "channels-service-group",
    "Topic": "notification-events"
  },
  "ChannelsService": {
    "DefaultTenantSettings": {
      "TenantId": "default",
      "EnabledChannels": ["Sms", "Email", "Push"],
      "PriorityOrder": {
        "Sms": 1,
        "Email": 2,
        "Push": 3,
        "WhatsApp": 4,
        "Siren": 5
      },
      "MaxRetries": {
        "Sms": 3,
        "Email": 2,
        "Push": 2,
        "WhatsApp": 2,
        "Siren": 3
      },
      "FallbackOrder": ["Sms", "Push", "Email"]
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  }
}
