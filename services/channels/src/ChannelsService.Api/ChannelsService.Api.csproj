    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ChannelsService.Application/ChannelsService.Application.csproj" />
    <ProjectReference Include="../ChannelsService.Infrastructure/ChannelsService.Infrastructure.csproj" />
  </ItemGroup>

</Project>
