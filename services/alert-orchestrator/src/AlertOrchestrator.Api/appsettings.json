{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:9093",
    "Topics": {
      "RiskUpdated": "risk-updated",
      "RegionIntersected": "region-intersected",
      "Event": "alert-orchestrator-events",
      "Command": "alert-commands",
      "DeadLetter": "alert-orchestrator-dead-letter",
      "TenantUsage": "tenant-usage-events"
    },
    "ConsumerGroupId": "alert-orchestrator-group"
  },
  "Database": {
    "UsePostgreSql": true,
    "PostgreSqlConnectionString": ""
  },
  "Cache": {
    "UseRedis": true,
    "RedisConnectionString": "localhost:6379"
  },
  "Idempotency": {
    "ExpirationHours": 24,
    "CheckIntervalMinutes": 1
  },
  "Jwt": {
    "Issuer": "sentinel",
    "Audience": "sentinel",
    "SigningKey": ""
  },
  "ServiceToken": {
    "Issuer": "sentinel-service:alert-orchestrator",
    "Audience": "sentinel",
    "SigningKey": "",
    "Roles": [
      "TenantsBilling.Read"
    ]
  },
  "Services": {
    "TenantsBillingBaseUrl": "http://localhost:5055"
  }
}
