{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AlertOrchestrator": {
    "KafkaBootstrapServers": "localhost:9093",
    "ConsumerGroupId": "alert-orchestrator-group",
    "RiskUpdatedTopic": "risk-updated",
    "RegionIntersectedTopic": "region-intersected",
    "EventTopic": "alert-orchestrator-events",
    "CommandTopic": "alert-commands",
    "UsePostgreSql": false,
    "PostgreSqlConnectionString": "",
    "UseRedis": false,
    "RedisConnectionString": "",
    "IdempotencyExpirationHours": 24,
    "ExpirationCheckIntervalMinutes": 1
  }
}
