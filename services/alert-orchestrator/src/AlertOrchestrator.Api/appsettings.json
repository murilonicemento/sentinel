{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Grafana.Loki"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://localhost:3100",
          "labels": [
            {
              "key": "service",
              "value": "alert-orchestrator"
            },
            {
              "key": "environment",
              "value": "development"
            }
          ],
          "propertiesAsLabels": [
            "level",
            "service",
            "environment",
            "SourceContext"
          ]
        }
      }
    ]
  },
  "Loki": {
    "Url": "http://localhost:3100"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9093",
    "Topics": {
      "RiskUpdated": "risk-evaluated",
      "RegionIntersected": "region-intersected",
      "Event": "alert-orchestrator-event",
      "Command": "alert-orchestrator-command"
    },
    "ConsumerGroupId": "alert-orchestrator-group"
  },
  "Database": {
    "UsePostgreSql": true,
    "PostgreSqlConnectionString": ""
  },
  "Cache": {
    "UseRedis": true,
    "RedisConnectionString": "localhost:6379"
  },
  "Idempotency": {
    "ExpirationHours": 24,
    "CheckIntervalMinutes": 1
  }
}
