{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Loki": {
    "Url": ""
  },
  "Elasticsearch": {
    "Url": "http://localhost:9200",
    "DefaultIndex": "geospatial-events"
  },
  "ConnectionStrings": {
    "Kafka": "localhost:9092"
  }
}
