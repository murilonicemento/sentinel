{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Elasticsearch": {
    "Url": "http://localhost:9200",
    "DefaultIndex": "geospatial-events"
  },
  "ConnectionStrings": {
    "Kafka": "localhost:9092"
  },
  "KafkaConsumerOptions": {
    "Topics": [ "disaster-event-detected", "climatic-event-detected" ],
    "DeadLetterTopic": "geospatial-dead-letter"
  }
}
