{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MongoDb": "mongodb://localhost:27017"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9093",
    "Topic": "risk-events",
    "GroupId": "risk-evaluation-group"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "risk-evaluation:"
  },
  "Loki": {
    "Url": "http://localhost:3100"
  },
  "RiskModel": {
    "Version": "1.0",
    "Parameters": {
      "gust": 0.4,
      "precipitation": 0.4,
      "pressure": 0.2
    },
    "Formula": "(gust * 0.4) + (precipitation * 0.4) + (pressure * 0.2)"
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Grafana.Loki"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "${LOKI_URL}",
          "labels": [
            {
              "key": "service",
              "value": "risk-evaluation"
            },
            {
              "key": "environment",
              "value": "development"
            }
          ],
          "propertiesAsLabels": ["level", "service", "environment"]
        }
      }
    ]
  },
  "Services": {
    "Ingestion": {
      "BaseUrl": "http://localhost:5001/"
    },
    "RiskCatalog": {
      "BaseUrl": "http://localhost:5002/"
    },
    "Geospatial": {
      "BaseUrl": "http://localhost:5003/",
      "ApiKey": "sua-api-key-aqui"
    }
  }
}
