{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MongoDb": "mongodb://localhost:27017",
    "Redis": "localhost:6379"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9093",
    "Topic": "risk-events",
    "GroupId": "risk-evaluation-group"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "risk-evaluation:"
  },
  "RiskModel": {
    "Version": "1.0",
    "Parameters": {
      "gust": 0.4,
      "precipitation": 0.4,
      "pressure": 0.2
    },
    "Formula": "(gust * 0.4) + (precipitation * 0.4) + (pressure * 0.2)"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Services": {
    "Ingestion": {
      "BaseUrl": "http://localhost:5001/"
    },
    "RiskCatalog": {
      "BaseUrl": "http://localhost:5002/"
    }
  },
  "Jwt": {
    "Issuer": "sentinel",
    "Audience": "sentinel",
    "SigningKey": ""
  },
  "ServiceToken": {
    "Issuer": "sentinel-service:risk-evaluation",
    "Audience": "sentinel",
    "SigningKey": "",
    "Roles": [
      "RiskCatalog.Read"
    ]
  }
}
